# Shared root-level example. Each workspace (backend/frontend) also has its own .env.example.
# Copy the relevant one to backend/.env and frontend/.env.local before running.

# --- Chain ---
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
BACKEND_PRIVATE_KEY=0xyour_backend_signer_private_key
ESCROW_ADDRESS=
MOCK_USDC_ADDRESS=

# --- AI matching ---
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- QR / booking security ---
QR_SIGNING_SECRET=change_me_super_secret

# --- Custodial guide wallets (32-byte hex) ---
WALLET_ENCRYPTION_KEY=

# --- Simulated M-Pesa (fallback only if live FX is unreachable) ---
USDC_TO_KES_RATE=145

# --- Backend server ---
PORT=4000
