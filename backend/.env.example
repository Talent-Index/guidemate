# Chain
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
BACKEND_PRIVATE_KEY=0xyour_backend_signer_private_key
ESCROW_ADDRESS=
MOCK_USDC_ADDRESS=
# Company wallet: 15% platform cut + 50% inconvenience fee
PROTOCOL_TREASURY_ADDRESS= 

# Supabase (accounts, experiences, bookings). Get these from
# Project Settings > API in the Supabase dashboard.
# NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend - service-role only, backend use only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# AI matching (optional - falls back to local keyword matching if missing).
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# QR / booking security
QR_SIGNING_SECRET=change_me_super_secret

# AES-256-GCM key for custodial guide wallets (32-byte hex). Receive-only today -
# the encrypted private key is stored for future withdrawals, not used at runtime.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_ENCRYPTION_KEY=

# Optional fallback only if live FX is unreachable (KES per 1 USDC).
# Display rates and simulated M-Pesa payouts use live USD/USDC markets.
USDC_TO_KES_RATE=145

# Live streaming (optional - /live is unavailable until these are set).
# Create a free project at https://cloud.livekit.io, then Settings > Keys.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://your-project.livekit.cloud

# Recording (optional - streams work without this, they just won't be saved
# for on-demand replay). Get S3 credentials from Supabase Dashboard >
# Project Settings > Storage > S3 Connection, and create a public
# "stream-recordings" bucket first.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=us-east-1
SUPABASE_S3_BUCKET=stream-recordings

PORT=4000
