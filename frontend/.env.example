NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Public site URL for QR codes in production (e.g. https://yourguidemate.top)
NEXT_PUBLIC_APP_URL=

# Supabase project - anon/publishable key only (safe for the browser, never the service role key)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Deployed contracts on Avalanche Fuji testnet
NEXT_PUBLIC_MOCK_USDC_ADDRESS=
NEXT_PUBLIC_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc

# Live streaming (optional - /live shows a "not configured" message without
# this). Must match backend/.env's LIVEKIT_URL - this is the browser-facing
# wss:// URL clients connect to directly.
NEXT_PUBLIC_LIVEKIT_URL=
